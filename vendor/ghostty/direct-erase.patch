+/// Host erase without touching the program stream, modes or scrolling margins.
+pub fn erase(self: *Terminal, clear_history: bool) void {
+    const screen = self.screens.active;
+    screen.clearRows(.{ .active = .{} }, null, false);
+    screen.cursor.pending_wrap = false;
+    screen.cursorAbsolute(0, 0);
+    if (clear_history) screen.eraseHistory(null);
+    screen.scroll(.{ .active = {} });
+    if (comptime build_options.kitty_graphics) {
+        screen.kitty_images.delete(screen.alloc, self, .{ .all = true });
+    }
+    self.flags.dirty.clear = true;
+}
